# CognoDB Cloud Connection Details
# Replace with your actual credentials from console.cognodb.com
COGNODB_URI=bolt+s://<instance-id>.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=your_saved_password_here

# Backend configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# (Optional) AML HelperBot LLM Integration
# Provide your Google Gemini or OpenAI API key for live AI generation.
# If omitted, AML HelperBot uses its built-in regulatory domain synthesis engine.
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
